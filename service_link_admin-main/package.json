	"scripts": {
		"start": " set NODE_OPTIONS=--openssl-legacy-provider && set PORT=3001  && react-app-rewired start",
		"start:dev": " set NODE_OPTIONS=--openssl-legacy-provider && set PORT=3001  && react-app-rewired start",
		"start:mac": "export set NODE_OPTIONS=--openssl-legacy-provider && set PORT=3001  && react-app-rewired start",
		"build": "cross-env NODE_OPTIONS=--openssl-legacy-provider GENERATE_SOURCEMAP=false react-app-rewired --max_old_space_size=4096 build",
		"build:mac": "cross-env NODE_OPTIONS=--openssl-legacy-provider GENERATE_SOURCEMAP=false react-app-rewired --max_old_space_size=4096 build",
		"serve": "serve -s build",
		"test": "react-scripts test --env=jsdom",
		"eject": "react-scripts eject"
	},
	"eslintConfig": {
		"extends": "react-app",
		"plugins": [
			"react-hooks"
		],
		"rules": {
			"react-hooks/rules-of-hooks": "error",
			"react-hooks/exhaustive-deps": "off"
		},
		"overrides": [
			{
				"files": ["src/containers/reports/new-reports.tsx"],
				"rules": {
					"react-hooks/rules-of-hooks": "off"
				}
			}
		]
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.{js,md,css}": [
			"prettier --trailing-comma es5 --single-quote --write"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}

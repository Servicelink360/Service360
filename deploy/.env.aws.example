# Copy to service_link_api-main/.env on the server and set RDS values after setup-aws-test.ps1

MODE=PROD
PORT=5301

DATABASE_CONNECTION=postgres
DATABASE_HOST=REPLACE_WITH_RDS_ENDPOINT
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=REPLACE_WITH_RDS_PASSWORD
DATABASE_DB_NAME=service360
DATABASE_SYNC=false

BCRYPT_SALT=10
API_PREFIX=v1
JWT_SECRET_KEY=CHANGE_ME
JWT_EXPIRES_IN=2592000s
JWT_REFRESH_SECRET_KEY=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=2592000s
PASSWORD_SALT=CHANGE_ME

REDIS_IP=redis
REDIS_PORT=6379

BASE_UPLOAD_URL=http://REPLACE_WITH_PUBLIC_API_URL:5301/

# Copy to /opt/app/deploy/https.env after DNS A records point to this EC2 Elastic IP.
# Then run: sudo bash /opt/app/deploy/setup-https.sh

API_DOMAIN=api.service360.com.au
ADMIN_DOMAIN=admin.service360.com.au
SSL_EMAIL=admin@service360.com.au

# Used by ec2-deploy.sh for admin build + API BASE_UPLOAD_URL
API_URL=https://api.service360.com.au/

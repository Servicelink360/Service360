{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "training/data/**/*",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "training/assets/**/*",
        "outDir": "dist",
        "watchAssets": true
      },
      {
        "include": "toolbox/assets/**/*",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ]
  }
}

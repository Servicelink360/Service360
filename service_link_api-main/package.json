  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"../../**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/src/main.js",
    "start:dev": "nest build --webpack --webpackPath webpack-hmr.config.js --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:seed": "ts-node ./node_modules/typeorm-seeding/dist/cli.js seed",
    "debug:upload": "node scripts/debug-api-upload.js",
    "db:inspect-schema": "node scripts/inspect-db-schema.js",
    "db:dashboard-unread": "node scripts/apply-dashboard-db-patch.js",
    "db:dedupe-sites": "node scripts/dedupe-sites.js",
    "db:dedupe-sites:apply": "node scripts/dedupe-sites.js --apply --record-patch",
    "db:inspect-sites": "node scripts/inspect-sites-duplicates.js",
    "db:check": "node scripts/check-db-corruption.js",
    "db:dedupe-all": "node scripts/dedupe-duplicate-ids.js",
    "db:dedupe-all:apply": "node scripts/dedupe-duplicate-ids.js --apply --record-patch",
    "db:unique-keys": "node scripts/apply-unique-constraints.js",
    "db:unique-keys:apply": "node scripts/apply-unique-constraints.js --apply --record-patch",
    "db:services-numeric-id": "node scripts/apply-departments-numeric-id.js",
    "db:report-template-services": "node scripts/apply-report-template-departments.js",
    "db:rename-departments-to-services": "node scripts/apply-rename-departments-to-services.js",
    "db:import-dump": "node scripts/import-from-mysql-dump.js",
    "db:list-droppable": "node scripts/list-droppable-tables.js",
    "db:drop-legacy-sql": "node scripts/list-droppable-tables.js --sql"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@nestjs-modules/ioredis": "^1.0.1",

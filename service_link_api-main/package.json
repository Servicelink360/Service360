    "axios": "^1.6.5",
    "bcrypt": "^5.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^8.6.0",
    "fastify-compress": "^3.6.0",
    "fastify-csrf": "^3.1.0",
    "fastify-multer": "^2.0.3",
    "fastify-static": "^4.6.1",
    "fastify-swagger": "^0.6.1",
    "fs": "^0.0.1-security",
    "handlebars": "^4.7.7",
    "ioredis": "^4.28.5",
    "moment": "^2.29.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.16.0",
    "nest-winston": "^1.6.2",
